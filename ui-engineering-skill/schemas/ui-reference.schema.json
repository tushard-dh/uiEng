{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "reference"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "reference": {
      "type": "object",
      "required": [
        "source",
        "reference_id"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "reference_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "selected_by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "pattern": {
          "type": "string",
          "description": "The specific UI pattern this reference answers (e.g. \"primary navigation\", \"tabs\", \"action bar\", \"button style\"), not the whole screen — see workflows/pattern-gallery.md."
        },
        "alternatives_shown": {
          "type": "array",
          "items": { "type": "string" },
          "description": "reference_ids of the other options presented for this pattern before this one was selected, for provenance."
        }
      }
    }
  }
}